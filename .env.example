# =============================================================================
# The Buggy Shop (WebForge v11.1) - Environment Variables Configuration
# =============================================================================
# Paste these environment variables into your Vercel Project:
# Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# =============================================================================

# 1. ZOHO SMTP EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=sales@thebuggyshoppty.com.au
SMTP_PASS=PyVxdL1ZiDzJ
SMTP_FROM="The Buggy Shop" <sales@thebuggyshoppty.com.au>

# 2. DESTINATION INBOXES FOR SHOP NOTIFICATIONS
# -----------------------------------------------------------------------------
ORDER_EMAIL=sales@thebuggyshoppty.com.au
CONTACT_EMAIL=sales@thebuggyshoppty.com.au
WHOLESALE_EMAIL=sales@thebuggyshoppty.com.au

# 3. REPLY PORTAL ADMIN HUB PASSCODE (/admin)
# -----------------------------------------------------------------------------
ADMIN_PASSCODE=orderreply

# 4. UPSTASH REDIS (For /admin Dashboard Order & Enquiry Persistence)
# -----------------------------------------------------------------------------
# Connected automatically via Vercel Storage tab -> Create Database (KV / Redis)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# 5. AI ENGINE & APP METADATA
# -----------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://thebuggyshop.com.au"
