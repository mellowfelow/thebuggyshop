# =============================================================================
# The Buggy Shop - Environment Variables (TEMPLATE ONLY - never commit real values)
# Set these in Vercel: Project -> Settings -> Environment Variables
# =============================================================================

# 1. SMTP EMAIL (any provider, e.g. Zoho)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com.au
SMTP_PASS=
SMTP_FROM="The Buggy Shop" <you@yourdomain.com.au>

# 2. DESTINATION INBOXES FOR SHOP NOTIFICATIONS
ORDER_EMAIL=
CONTACT_EMAIL=
WHOLESALE_EMAIL=

# 3. REPLY PORTAL ADMIN HUB PASSCODE (/admin)
#    REQUIRED, min 8 chars. There is NO default: /admin is refused until this is set.
ADMIN_PASSCODE=

# 4. UPSTASH REDIS (order & enquiry persistence for /admin)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 5. PUBLIC SITE URL (used for links inside emails; also set SITE.domain in src/config/site.js)
SITE_URL=
